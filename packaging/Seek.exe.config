<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Framework 配置：窗口组件 pywebview 通过 pythonnet 加载 Python.Runtime.dll。
  从网上下载的 zip 解压后，文件带有“来自 Internet”标记，.NET 默认拒绝加载，
  开启 loadFromRemoteSources 后允许加载程序自带的这些程序集。
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
