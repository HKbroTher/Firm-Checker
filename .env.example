ANTHROPIC_API_KEY=sk-ant-...
# Claude 模型
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# ChromaDB 持久化目录
CHROMA_DIR=./data/chroma
# 向量化方式：bge-m3 = BAAI/bge-m3 多语言模型（中文效果好，首次运行下载约 2.3GB）
#            default = Chroma 内置 all-MiniLM-L6-v2（英文为主）；hash = 离线哈希向量（仅供测试/演示）
EMBEDDING_BACKEND=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
# 有 GPU 时改为 cuda
EMBEDDING_DEVICE=cpu
# 国内网络可使用 Hugging Face 镜像
# HF_ENDPOINT=https://hf-mirror.com
CHUNK_SIZE=800
CHUNK_OVERLAP=150
